APP_NAME=Conecta IoT Angola

APP_VERSION=0.1.0

DEBUG=True

HOST=0.0.0.0

PORT=8000

DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=postgres
DB_PORT=5432
DB_NAME=conecta

REDIS_URL=redis://redis:6379

MQTT_HOST=emqx

MQTT_PORT=1883

MQTT_USERNAME=admin

MQTT_PASSWORD=public

# Gere um valor aleatório forte e use o mesmo valor no .env da API e no compose do EMQX.
EMQX_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

MQTT_DEVICE_OFFLINE_AFTER_SECONDS=120

MQTT_HEARTBEAT_CHECK_INTERVAL_SECONDS=30

SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=60

REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS: JSON array of exact origins; required when DEBUG=False.
CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# SMTP is required for password recovery; email alerts are still pending.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=True
PASSWORD_RESET_URL=ciao://recuperar
